{
  "$comment": "Base design tokens. Mirrored into Bricks Global Variables Manager. Skins override a subset of these; layouts never touch them directly. Fluid values use clamp(min, preferred, max) so no breakpoint patching is ever needed.",
  "version": "0.1.0",

  "color": {
    "$comment": "Semantic names only. A skin remaps these; components never reference raw hex.",
    "surface-0": "#ffffff",
    "surface-1": "#f6f7f9",
    "surface-2": "#eceff3",
    "surface-inverse": "#0b0e14",
    "surface-inverse-2": "#141924",
    "text-strong": "#0b0e14",
    "text-body": "#39414f",
    "text-muted": "#6b7583",
    "text-on-inverse": "#f3f5f8",
    "text-on-inverse-muted": "#9aa5b4",
    "accent": "#2563eb",
    "accent-hover": "#1d4ed8",
    "accent-contrast": "#ffffff",
    "accent-soft": "#dbe6ff",
    "border": "#dfe4ea",
    "border-inverse": "#252c3a",
    "success": "#16a34a",
    "warning": "#d97706",
    "danger": "#dc2626"
  },

  "type": {
    "font-display": "system-ui, sans-serif",
    "font-body": "system-ui, sans-serif",
    "weight-display": "700",
    "weight-body": "400",
    "weight-bold": "600",
    "size-xs": "clamp(0.75rem, 0.72rem + 0.15vw, 0.8125rem)",
    "size-sm": "clamp(0.875rem, 0.85rem + 0.15vw, 0.9375rem)",
    "size-base": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
    "size-lg": "clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem)",
    "size-xl": "clamp(1.375rem, 1.22rem + 0.7vw, 1.75rem)",
    "size-2xl": "clamp(1.75rem, 1.45rem + 1.4vw, 2.5rem)",
    "size-3xl": "clamp(2.25rem, 1.7rem + 2.6vw, 3.5rem)",
    "size-4xl": "clamp(2.75rem, 1.8rem + 4.4vw, 5rem)",
    "size-hero": "clamp(3rem, 1.6rem + 6.2vw, 6.5rem)",
    "leading-tight": "1.05",
    "leading-snug": "1.2",
    "leading-body": "1.6",
    "tracking-display": "-0.03em",
    "tracking-body": "0",
    "tracking-eyebrow": "0.14em",
    "measure": "62ch"
  },

  "space": {
    "$comment": "8pt grid. Section padding is fluid — cramped sections are the #1 tell of a cheap site.",
    "3xs": "0.25rem",
    "2xs": "0.5rem",
    "xs": "0.75rem",
    "sm": "1rem",
    "md": "1.5rem",
    "lg": "2rem",
    "xl": "3rem",
    "2xl": "4rem",
    "3xl": "6rem",
    "section-y": "clamp(4rem, 2.5rem + 6vw, 10rem)",
    "section-y-tight": "clamp(2.5rem, 1.8rem + 3vw, 5rem)",
    "gutter": "clamp(1.25rem, 0.9rem + 1.6vw, 2.5rem)",
    "container": "1240px",
    "container-narrow": "820px",
    "container-wide": "1560px"
  },

  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },

  "shadow": {
    "$comment": "One large low-opacity shadow beats three tight ones.",
    "sm": "0 1px 2px rgb(11 14 20 / 0.06)",
    "md": "0 8px 24px -8px rgb(11 14 20 / 0.12)",
    "lg": "0 24px 64px -16px rgb(11 14 20 / 0.18)",
    "glow": "0 0 48px -8px var(--gf-color-accent)",
    "rim": "inset 0 1px 0 rgb(255 255 255 / 0.12)"
  },

  "motion": {
    "$comment": "Slow and subtle reads as premium. Fast and bouncy reads as amateur.",
    "dur-fast": "180ms",
    "dur-base": "320ms",
    "dur-slow": "600ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "distance": "24px"
  },

  "depth": {
    "$comment": "Drives the tiered depth system. See docs/3D-DEPTH-SYSTEM.md.",
    "tier": 1,
    "grain-opacity": "0.04",
    "glass-blur": "16px",
    "glass-fill": "rgb(255 255 255 / 0.06)",
    "glass-border": "rgb(255 255 255 / 0.10)",
    "tilt-deg": "2deg",
    "parallax-strength": "0.12",
    "mesh-opacity": "0.55"
  },

  "asset": {
    "$comment": "Shared depth assets, referenced by the depth-layer component. Paths are relative to the theme's asset root so a skin can swap the whole set. See docs/3D-DEPTH-SYSTEM.md.",
    "noise-tile": "url('/assets/3d/shared/noise-tiles/grain-128.png')",
    "mesh-a": "url('/assets/3d/shared/mesh-gradients/mesh-a.webp')",
    "mesh-b": "url('/assets/3d/shared/mesh-gradients/mesh-b.webp')"
  },

  "layout": {
    "header-height": "76px",
    "z-header": "100",
    "z-modal": "500",
    "z-sticky-cta": "90"
  }
}
