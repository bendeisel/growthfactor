---
// CLASS PAGE TEMPLATE (first of 3) — see README for what's real vs. what
// was stripped. Copy below is verbatim from the client's WordPress export
// (Tools > Export, 2026-08-26), minus the em dashes (Ben's standing rule:
// none, ever) and minus the theme's leftover CrossFit-demo furniture,
// which never belonged to this gym and was never customized:
//   - fake hero tagline "Hello, we are power / The best CrossFit
//     experience for explosive power"
//   - generic "Personal trainings / Group trainings / Beginners' programs
//     / Family programs" service cards (Lorem Ipsum body text, linked to
//     /services/ URLs that don't exist on this site)
//   - "CrossFit programs" 3-up grid (Sports nutrition / Online training /
//     Rehabilitation, all Lorem Ipsum)
//   - "Pice table" pricing table (Basic $60 / Standard $80, Lorem Ipsum)
//   - a 4-city contact list (New York/Boston/LA/Austin, fake numbers) left
//     over from the theme's multi-location demo
// The three real paragraphs below ARE genuine, finished client copy and
// ship verbatim. Page title, both sub-headings, and all copy are exact.
import Base from '../layouts/Base.astro';
import ClassTicker from '../components/ClassTicker.astro';

const pageTitle = 'Beginners Boxing Class | Fighters Boxing Gym';
const description =
  'Our Beginners Boxing Class is where your journey starts: a non-contact, technique-driven program built for anyone looking to learn the art of boxing the right way.';
---

<Base title={pageTitle} description={description}>
  <!-- ============ HERO: photo band, not video (per Ben, inner pages) ============ -->
  <section class="hero grain">
    <img
      class="hero-photo"
      src="/img/classes/boxing-basics.jpg"
      alt="Coach guarding up while a boxer works the mitts at Fighters Boxing Gym"
      width="1040"
      height="640"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 class="reveal">BEGINNERS BOXING CLASS</h1>
      <span class="btn-ring reveal">
        <button class="btn js-open-lead" type="button">GET STARTED</button>
      </span>
    </div>
  </section>

  <!-- ============ BODY: the three real paragraphs, verbatim ============ -->
  <section class="split grain fluid-host">
    <div class="wrap copy-col">
      <h2 class="reveal">Learn the Foundations of Real Boxing</h2>
      <p class="reveal">
        Our <b>Beginners Boxing Class</b> is where your journey starts. This is a
        <b>non-contact, technique-driven program</b> built for anyone looking to learn the art of
        boxing the right way. You’ll master the essentials: stance, footwork, defense, and proper
        punching mechanics, under the guidance of <b>USA Certified coaches</b> who teach with
        patience, precision, and passion. Every session builds your coordination, timing, and
        conditioning while keeping the atmosphere fun, challenging, and safe.
      </p>
      <p class="reveal read-more"><a href="/what-to-expect/">Read More</a></p>

      <h3 class="reveal">Train Like a Fighter, Without Taking a Punch</h3>
      <p class="reveal">
        You don’t need to be in fighting shape to start. You just need the will to show up. Our
        coaches break down every movement step-by-step so you can train confidently, improve your
        fitness, and build a fighter’s mindset. Expect sweat, progress, and motivation from the
        moment you step on the floor.
      </p>

      <h3 class="reveal">A Gym Built for Everyone</h3>
      <p class="reveal">
        We built Fighters Boxing Gym for people of all experience levels from those stepping into
        the gym for the first time to those who just want to stay sharp. You’ll leave every class
        stronger, more confident, and ready to take on the next challenge inside and outside the
        ring.
      </p>

      <span class="btn-ring reveal">
        <button class="btn js-open-lead" type="button">GET STARTED</button>
      </span>
    </div>
  </section>

  <!-- ============ cross-nav to the other classes ============ -->
  <div class="ticker">
    <ClassTicker currentHref="/beginners-boxing-class/" />
  </div>
</Base>

<style>
  /* ---------- hero: photo band ---------- */
  .hero {
    position: relative;
    overflow: clip;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(62vh - 88px);
    padding: clamp(56px, 8vw, 100px) 0;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      rgba(9, 9, 9, 0.55),
      rgba(9, 9, 9, 0.38)
    );
  }
  .hero-inner { position: relative; }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(34px, 5.4vw, 64px);
    color: var(--on-dark);
    margin-bottom: clamp(24px, 3vw, 36px);
  }
  .hero .btn-ring { --ring-gap: #131313; }
  .hero :global(.btn) { border-color: #131313; }

  /* ---------- body ---------- */
  .split { position: relative; overflow: clip; padding: var(--section-pad) 0; background: var(--ground); }
  .copy-col { max-width: 760px; }
  .copy-col h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    margin-bottom: clamp(18px, 2.4vw, 26px);
  }
  .copy-col h3 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: clamp(32px, 4vw, 44px) 0 14px;
  }
  .copy-col p { max-width: 68ch; }
  .read-more a { font-family: var(--font-display); font-weight: 700; }
  .copy-col .btn-ring { margin-top: clamp(32px, 4vw, 44px); }

  /* ---------- cross-nav ticker ---------- */
  .ticker {
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
  }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
  }
</style>

<script>
  import { mountFluidBg } from '../scripts/fluid-bg.js';
  const reducedFluid = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedFluid) {
    const start = () => {
      document.querySelectorAll('.fluid-host').forEach((host) => mountFluidBg(host));
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 800);
  }
</script>
