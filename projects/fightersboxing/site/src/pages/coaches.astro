---
// COACHES
//
// Every name, role, and credential below comes from the client's own
// WordPress export (Tools > Export, 2026-08-26). No photos: the client's
// media library sits on the dev domain, unreachable from this build. Send
// real headshots and they replace the initial roundels directly; see
// source/inner-pages.md.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ClassTicker from '../components/ClassTicker.astro';
import { coaches } from '../data/coaches.js';

const founder = coaches[0];
const staff = coaches.slice(1);

const initials = (name) =>
  name
    .replace(/^Dr\.\s+/, '')
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<Base
  title="Coaches | Fighters Boxing Gym Nashville"
  description="Meet the coaching staff at Fighters Boxing Gym: USA Boxing certified coaches, former competitors, and the Olympic coach who founded the gym."
>
  <PageHeader lines={['MEET THE', 'COACHES']} sub="USA Certified coaches who have done the work themselves" />

  <!-- ============ FOUNDER ============ -->
  <section class="split grain fluid-host">
    <div class="wrap split-grid">
      <div class="split-copy">
        <p class="kicker reveal">Founder & Director</p>
        <h2 class="reveal">{founder.name}</h2>
        <div class="reveal" set:html={founder.bio} />
        <ul class="creds reveal">
          {founder.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="reveal founder-mark" aria-hidden="true">
        <span>{initials(founder.name)}</span>
      </div>
    </div>
  </section>

  <!-- ============ STAFF ============ -->
  <section class="staff grain alt fluid-host">
    <div class="wrap">
      <h2 class="staff-title reveal">The Coaching Staff</h2>
      <div class="staff-grid">
        {
          staff.map((c) => (
            <article class="coach reveal">
              <span class="coach-mark" aria-hidden="true">{initials(c.name)}</span>
              <h3 class="coach-name">{c.name}</h3>
              <p class="coach-role">{c.role}</p>
              <ul class="coach-creds">
                {c.credentials.map((cr) => <li>{cr}</li>)}
              </ul>
              {c.instagram && (
                <a class="coach-ig" href={c.instagram} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
                  </svg>
                  Instagram
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CLOSE ============ -->
  <section class="close grain fluid-host">
    <div class="wrap close-inner">
      <h2 class="reveal">Train with the best</h2>
      <p class="reveal">
        Come meet the coaches, watch a class, and see which one fits where you are
        starting from.
      </p>
      <span class="btn-ring reveal">
        <button class="btn js-open-lead" type="button">GET MORE INFO</button>
      </span>
    </div>
  </section>

  <div class="ticker">
    <ClassTicker />
  </div>
</Base>

<style>
  .kicker {
    font-family: var(--font-action);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: clamp(10px, 1.2vw, 16px);
  }
  .creds {
    list-style: none;
    margin: clamp(18px, 2.4vw, 26px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .creds li, .coach-creds li {
    font-family: var(--font-action);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--ground-alt);
    border-radius: var(--radius-pill);
    padding: 8px 14px;
  }

  .founder-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    background: var(--ground-alt);
    border-radius: calc(var(--radius-panel) + 10px);
  }
  .founder-mark span {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(64px, 9vw, 130px);
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .staff {
    background: var(--ground-alt);
    padding: var(--section-pad) 0;
  }
  .staff-title {
    font-size: clamp(28px, 3.6vw, 46px);
    margin-bottom: clamp(28px, 3.6vw, 44px);
  }
  .staff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: clamp(20px, 2.4vw, 30px);
  }
  .coach {
    background: var(--ground);
    border-radius: calc(var(--radius-panel) + 6px);
    padding: clamp(22px, 2.4vw, 30px);
    box-shadow: var(--shadow-popup);
  }
  .coach-mark {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-dark);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    margin-bottom: clamp(16px, 2vw, 22px);
  }
  .coach-name {
    font-size: clamp(19px, 2vw, 22px);
    margin-bottom: 4px;
  }
  .coach-role {
    font-family: var(--font-action);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: clamp(14px, 1.8vw, 20px);
  }
  .coach-creds {
    list-style: none;
    margin: 0 0 clamp(14px, 1.8vw, 20px);
    padding: 0;
    display: grid;
    gap: 8px;
    justify-content: start;
  }
  .coach-creds li {
    background: none;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
    color: var(--text-dark);
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    font-size: 14px;
    font-family: var(--font-body);
  }
  .coach-ig {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
  }

  .close {
    background: var(--ground);
    padding: clamp(44px, 6vw, 82px) 0;
    text-align: center;
  }
  .close h2 { font-size: clamp(26px, 3.2vw, 40px); margin-bottom: 14px; }
  .close p { max-width: 52ch; margin-inline: auto; margin-bottom: clamp(22px, 3vw, 32px); }

  .ticker {
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
  }

  @media (max-width: 900px) {
    .split-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { mountFluidBg } from '../scripts/fluid-bg.js';
  const reducedFluid = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedFluid) {
    const start = () => {
      document.querySelectorAll('.fluid-host').forEach((host) => {
        const opts = {};
        const o = Number(host.dataset.fluidOpacity);
        const p = Number(host.dataset.fluidPixel);
        if (o) opts.opacity = o;
        if (p) opts.pixelSize = p;
        mountFluidBg(host, opts);
      });
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 800);
  }
</script>
