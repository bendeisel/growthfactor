---
import Base from '../layouts/Base.astro';

// Meta description reuses the hero's own subline; copy is frozen at 99%.
const description =
  'Join Nashville’s Best Boxing Gym and Find Something Worth Fighting For.';

// Class names as Ben supplied them (2026-08-24). Masters boxing has no page
// on the WP build yet; it points at the classes index until one exists.
const classes = [
  { n: '01', name: 'Boxing basics', href: '/beginners-boxing-class/' },
  { n: '02', name: 'Competition Team', href: '/competition-team-training/' },
  { n: '03', name: 'Youth boxing', href: '/youth-boxing-class/' },
  { n: '04', name: 'Masters boxing', href: '/boxing-classes/' },
];

const tickerRepeats = 3;
---

<Base title="Fighters Nashville" description={description}>
  <!-- ============ HERO: reserved for fbg-header.mp4 ============
       Drop the media guy's resized file at public/video/fbg-header.mp4 and
       it plays; until then the dark ground stands in. -->
  <section class="hero grain">
    <video class="hero-video" autoplay muted loop playsinline aria-hidden="true">
      <source src="/video/fbg-header.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <span class="deco-diamond" aria-hidden="true"></span>
    <span class="deco-ring" aria-hidden="true"></span>
    <div class="wrap hero-inner">
      <h1 class="reveal">WHAT ARE YOU FIGHTING FOR?</h1>
      <p class="sub reveal">Join Nashville’s Best Boxing Gym and Find Something Worth Fighting For.</p>
      <span class="btn-ring reveal">
        <button class="btn js-open-lead" type="button">GET STARTED</button>
      </span>
    </div>
  </section>

  <!-- ============ SECTION 1 ============ -->
  <section class="split grain">
    <div class="wrap split-grid">
      <div class="split-copy">
        <h2 class="reveal"><span class="mark" aria-hidden="true"></span>WE ARE ALL FIGHTERS: WHAT ARE YOU FIGHTING FOR?</h2>
        <div class="reveal">
          <p>Everyone’s fighting for something.</p>
          <p>
            For some, it’s fitness. For others, it’s focus, confidence, or just a little peace of
            mind. Whatever your fight looks like, you’ll find your place here.
          </p>
          <p>
            At <b>Fighters Boxing Gym</b>, we’ve built more than a gym we’ve built a community. A
            place where people push limits, support each other, and keep showing up no matter what
            life throws their way. Whether you’re stepping into the ring for the first time or
            training for your next bout, you’ll get real coaching, real results, and people who’ve
            got your back.
          </p>
          <p>No egos. No gimmicks. Just hard work, respect, and progress.</p>
          <p>
            You’ll leave every class stronger not just in body, but in mindset. When you train
            here, you learn more than combinations and footwork. You learn to stay calm under
            pressure, to show up when it’s hard, and to keep fighting in and out of the ring.
          </p>
        </div>
        <span class="btn-ring reveal">
          <button class="btn js-open-lead" type="button">GET STARTED</button>
        </span>
      </div>
      <figure class="split-media mat mat-warm reveal">
        <span class="deco-ring-sm" aria-hidden="true"></span>
        <img
          src="/img/training-mitts-800.jpg"
          alt="Coach guarding up while a boxer works the double-end bag at Fighters Boxing Gym"
          loading="lazy"
          width="800"
          height="534"
        />
      </figure>
    </div>
  </section>

  <!-- ============ OUR CLASSES ticker (red line, white text) ============ -->
  <a class="ticker" href="#classes" aria-label="Our Classes">
    <div class="ticker-track">
      {
        [0, 1].map(() => (
          <span class="ticker-seg" aria-hidden="true">
            {Array.from({ length: tickerRepeats }).map(() => (
              <>
                <span class="ticker-label">Our Classes:</span>
                {classes.map((c) => (
                  <>
                    <span class="ticker-item">{c.name}</span>
                    <svg class="ticker-mark" viewBox="0 0 40 40">
                      <rect x="9" y="9" width="22" height="22" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.4" transform="rotate(45 20 20)" />
                      <circle cx="20" cy="20" r="8.6" fill="none" stroke="#FFFFFF" stroke-width="2.8" />
                    </svg>
                  </>
                ))}
              </>
            ))}
          </span>
        ))
      }
    </div>
  </a>

  <!-- ============ SECTION 2 (mirrored, warm ground) ============ -->
  <section class="split grain alt">
    <div class="wrap split-grid flip">
      <figure class="split-media mat mat-white reveal">
        <span class="deco-diamond-sm" aria-hidden="true"></span>
        <img
          src="/img/sparring-1600.webp"
          alt="Two boxers sparring in headgear while a Fighters coach watches from the ropes"
          loading="lazy"
          width="1600"
          height="1069"
        />
      </figure>
      <div class="split-copy">
        <h2 class="reveal"><span class="mark" aria-hidden="true"></span>NASHVILLE BOXING AT ITS BEST</h2>
        <div class="reveal">
          <p>Welcome to <b>Fighters Boxing Gym</b>, Nashville’s best boxing facility.</p>
          <p>
            We’re not just another fitness club with a few heavy bags in the corner. This is a
            real boxing gym built for real boxers.
          </p>
          <p>
            Our programs are designed for <b>all levels</b>, from total beginners to seasoned
            fighters, with options for
            <b>group classes, youth classes, private sessions, open gym, and sparring</b>. We’ve
            created an environment where everyone’s welcome to learn the classic art of boxing, get
            fit, and have fun doing it.
          </p>
          <p>
            We believe boxing isn’t just a workout. It’s therapy, it’s discipline, it’s
            empowerment. It teaches you how to breathe under pressure, stay sharp when tired, and
            fight back when life hits hard. That’s why we’ve dropped every barrier to entry. No
            experience needed, no ego allowed. Just show up, put in the work, and discover what
            you’re capable of.
          </p>
          <p>So, what are you fighting for?</p>
          <p>
            Come find out inside Nashville’s best boxing gym, <b>Fighters Boxing Gym</b>, where
            every round counts and everyone has a reason to fight.
          </p>
        </div>
        <span class="btn-ring reveal">
          <button class="btn js-open-lead" type="button">GET STARTED</button>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ CLASSES ============ -->
  <section class="classes grain" id="classes">
    <div class="wrap">
      <h2 class="classes-title reveal"><span class="mark mark-ondark" aria-hidden="true"></span>Boxing Classes</h2>
      <ul class="class-grid">
        {
          classes.map((c) => (
            <li class="class-card reveal">
              <a href={c.href}>
                <span class="numeral-ring" aria-hidden="true">
                  <svg viewBox="0 0 96 96">
                    <rect x="20" y="20" width="56" height="56" fill="none" stroke="#DCDCD1" stroke-width="1.5" transform="rotate(45 48 48)" />
                    <circle class="nr-circle" cx="48" cy="48" r="34" fill="none" stroke="#CC0000" stroke-width="3" pathLength="100" />
                  </svg>
                  <b>{c.n}</b>
                </span>
                <span class="class-name">{c.name}</span>
                <span class="class-arrow" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 22 22">
                    <path d="M4 11h13M12 5l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero: dark stage for the background video ---------- */
  .hero {
    position: relative;
    background: var(--ground-band);
    overflow: clip;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(92vh - 88px);
    padding: clamp(72px, 10vw, 140px) 0;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the WP build's measured 0.7 dark overlay, kept so the white copy always reads */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: rgba(9, 9, 9, 0.7);
  }
  .hero-inner { position: relative; max-width: 900px; }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(40px, 6.6vw, 88px);
    color: var(--on-dark);
  }
  .hero .sub {
    font-size: clamp(17px, 2vw, 26px);
    line-height: 1.25;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--on-dark);
    margin: 24px auto 38px;
    max-width: 34ch;
  }
  .hero .btn-ring { --ring-gap: var(--ground-band); }
  .hero :global(.btn) { border-color: var(--ground-band); }
  .deco-ring {
    position: absolute;
    width: clamp(120px, 14vw, 220px);
    aspect-ratio: 1;
    border: 3px solid var(--accent);
    border-radius: 50%;
    left: max(-60px, -4vw);
    bottom: -8%;
    opacity: 0.8;
  }
  .deco-diamond {
    position: absolute;
    width: clamp(140px, 16vw, 260px);
    aspect-ratio: 1;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    transform: rotate(45deg);
    right: max(-70px, -5vw);
    top: -10%;
  }

  /* ---------- heading mark: the logo pair, small, before each H2 ---------- */
  .mark {
    display: block;
    width: 34px;
    height: 34px;
    margin-bottom: 18px;
    background:
      radial-gradient(circle at center, transparent 0 9px, var(--accent) 9.5px 12px, transparent 12.5px) no-repeat center;
    border: 0;
    position: relative;
  }
  .mark::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1.5px solid var(--border);
    transform: rotate(45deg);
  }
  .mark-ondark::after { border-color: rgba(255, 255, 255, 0.3); }

  /* ---------- split sections ---------- */
  .split { padding: var(--section-pad) 0; background: var(--ground); }
  .split.alt { background: var(--ground-alt); }
  .split-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 7vw, 110px);
    align-items: center;
  }
  .split-grid.flip { grid-template-columns: 0.85fr 1.15fr; }
  .split h2 {
    font-size: clamp(28px, 3.6vw, 46px);
    margin-bottom: clamp(20px, 3vw, 34px);
  }
  .split-copy p { max-width: 62ch; }
  .split-copy .btn-ring { margin-top: clamp(24px, 3vw, 40px); }
  .split.alt .btn-ring { --ring-gap: var(--ground-alt); }
  .split.alt :global(.btn) { border-color: var(--ground-alt); }

  /* photo in a mat frame: breathing room off the borders, color behind it */
  .split-media {
    margin: 0;
    position: relative;
    padding: clamp(14px, 1.6vw, 22px);
    border-radius: calc(var(--radius-panel) + 10px);
  }
  .mat-warm { background: var(--ground-alt); }
  .mat-white { background: var(--ground); box-shadow: var(--shadow-popup); }
  .split-media img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-panel);
    position: relative;
    z-index: 1;
  }
  .deco-ring-sm {
    position: absolute;
    width: clamp(70px, 8vw, 120px);
    aspect-ratio: 1;
    border: 3px solid var(--accent);
    border-radius: 50%;
    right: -6%;
    top: -7%;
    z-index: 2;
  }
  .deco-diamond-sm {
    position: absolute;
    width: clamp(80px, 9vw, 140px);
    aspect-ratio: 1;
    border: 1.5px solid var(--border);
    transform: rotate(45deg);
    left: -7%;
    bottom: -5%;
  }

  /* ---------- OUR CLASSES ticker: the red line ---------- */
  .ticker {
    display: block;
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
    text-decoration: none;
  }
  .ticker:hover, .ticker:focus-visible { background: var(--accent-hover); }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 30s linear infinite;
  }
  .ticker-seg { display: flex; align-items: center; }
  .ticker-label {
    font-family: var(--font-action);
    font-weight: 700;
    font-size: clamp(15px, 1.6vw, 20px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    padding: 0 1.1em 0 2em;
    white-space: nowrap;
  }
  .ticker-item {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(20px, 2.6vw, 34px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--on-dark);
    white-space: nowrap;
    padding: 0 0.55em;
  }
  .ticker-mark { width: clamp(18px, 2vw, 26px); height: clamp(18px, 2vw, 26px); flex: none; }
  @keyframes ticker-scroll {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  /* ---------- classes ---------- */
  .classes {
    background: var(--ground-band);
    padding: var(--section-pad) 0;
  }
  .classes-title {
    color: var(--on-dark);
    font-size: clamp(28px, 3.6vw, 46px);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .class-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }
  .class-card a {
    display: grid;
    gap: 18px;
    background: var(--ground);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    padding: clamp(22px, 2.4vw, 34px);
    min-height: 240px;
    align-content: start;
    color: var(--text-dark);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .class-card a:hover, .class-card a:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-popup);
    color: var(--text-dark);
  }
  .numeral-ring {
    position: relative;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
  }
  .numeral-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .numeral-ring b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    color: var(--text-dark);
  }
  .nr-circle {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    transform-origin: center;
    transition: transform 0.6s ease;
  }
  .class-card a:hover .nr-circle { transform: rotate(180deg); }
  .class-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(19px, 1.7vw, 24px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .class-arrow { color: var(--accent); }

  /* ---------- responsive ---------- */
  @media (max-width: 1000px) {
    .class-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .split-grid, .split-grid.flip { grid-template-columns: 1fr; }
    .split-grid.flip .split-media { order: 2; }
    .split-media { max-width: 460px; margin-inline: auto; }
  }
  @media (max-width: 560px) {
    .class-grid { grid-template-columns: 1fr; }
    .class-card a { min-height: 0; grid-template-columns: 84px 1fr auto; align-items: center; }
  }
</style>
