---
// CLASS PAGE TEMPLATE
// Per Ben (2026-08-26): no photo header band on inner pages. The H1 is the
// first thing on the page, then photos sit side by side with the text as
// you scroll, in the same mat frames as the homepage, over the ambient red
// fluid gradient.
//
// Each class page supplies only data: an H1, a meta description, and a list
// of sections. A section with an `image` renders as a split (photo beside
// copy, alternating sides down the page); a section without one renders as
// a centered closer carrying the final call to action.
import Base from './Base.astro';
import ClassTicker from '../components/ClassTicker.astro';

export interface ClassSection {
  heading: string;
  /** paragraph HTML; <b> emphasis preserved from the client's copy */
  body: string;
  readMore?: { href: string; label: string };
  image?: { src: string; alt: string; width: number; height: number };
}

interface Props {
  pageTitle: string;
  description: string;
  h1: string;
  sections: ClassSection[];
  currentHref: string;
}

const { pageTitle, description, h1, sections, currentHref } = Astro.props as Props;

const withPhoto = sections.filter((s) => s.image);
const closers = sections.filter((s) => !s.image);
---

<Base title={pageTitle} description={description}>
  <!-- ============ PAGE HEAD: H1 first, no photo band ============ -->
  <section class="page-head grain fluid-host">
    <div class="wrap">
      <p class="eyebrow reveal">Boxing Classes</p>
      <h1 class="reveal">{h1}</h1>
    </div>
  </section>

  <!-- ============ SPLITS: photo beside copy, alternating ============ -->
  {
    withPhoto.map((s, i) => {
      const flip = i % 2 === 1;
      return (
        <section class={`split grain first-split${flip ? ' alt' : ''}${i > 0 ? ' subsequent' : ''} fluid-host`}>
          <div class={`wrap split-grid${flip ? ' flip' : ''}`}>
            {flip && (
              <figure class="split-media mat mat-white reveal">
                <img
                  src={s.image!.src}
                  alt={s.image!.alt}
                  loading="lazy"
                  width={s.image!.width}
                  height={s.image!.height}
                />
              </figure>
            )}
            <div class="split-copy">
              <h2 class="reveal">{s.heading}</h2>
              <div class="reveal" set:html={s.body} />
              {s.readMore && (
                <p class="read-more reveal">
                  <a href={s.readMore.href}>{s.readMore.label}</a>
                </p>
              )}
            </div>
            {!flip && (
              <figure class="split-media mat mat-warm reveal">
                <img
                  src={s.image!.src}
                  alt={s.image!.alt}
                  loading="lazy"
                  width={s.image!.width}
                  height={s.image!.height}
                />
              </figure>
            )}
          </div>
        </section>
      );
    })
  }

  <!-- ============ CLOSER: centered, carries the CTA ============ -->
  {
    closers.map((s) => (
      <section class="closer grain fluid-host">
        <div class="wrap closer-inner">
          <h2 class="reveal">{s.heading}</h2>
          <div class="reveal" set:html={s.body} />
          <span class="btn-ring reveal">
            <button class="btn js-open-lead" type="button">GET STARTED</button>
          </span>
        </div>
      </section>
    ))
  }

  <!-- ============ cross-nav to the other classes ============ -->
  <div class="ticker">
    <ClassTicker currentHref={currentHref} />
  </div>
</Base>

<style>
  /* ---------- page head ---------- */
  .page-head {
    background: var(--ground);
    padding: clamp(44px, 6vw, 78px) 0 clamp(8px, 1.5vw, 18px);
  }
  .eyebrow {
    font-family: var(--font-action);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .page-head h1 {
    font-weight: 900;
    font-size: clamp(34px, 5.6vw, 68px);
    max-width: 22ch;
  }

  /* ---------- splits ---------- */
  /* the first split sits right under the page head, so it gets less top
     padding than a standalone section would */
  .first-split { padding-top: clamp(38px, 4.4vw, 58px); }
  .split.subsequent { padding-top: var(--section-pad); }
  .read-more {
    margin-top: clamp(14px, 2vw, 22px);
  }
  .read-more a {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* ---------- closer ---------- */
  .closer {
    background: var(--ground);
    padding: clamp(20px, 3vw, 40px) 0 var(--section-pad);
  }
  .closer-inner {
    max-width: 720px;
    text-align: center;
  }
  .closer h2 {
    font-size: clamp(26px, 3.2vw, 40px);
    margin-bottom: clamp(16px, 2.2vw, 24px);
  }
  .closer p { margin-inline: auto; }
  .closer .btn-ring { margin-top: clamp(26px, 3.4vw, 40px); }

  /* ---------- cross-nav ticker ---------- */
  .ticker {
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
  }
</style>

<script>
  import { mountFluidBg } from '../scripts/fluid-bg.js';
  const reducedFluid = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedFluid) {
    const start = () => {
      document.querySelectorAll('.fluid-host').forEach((host) => mountFluidBg(host));
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 800);
  }
</script>
