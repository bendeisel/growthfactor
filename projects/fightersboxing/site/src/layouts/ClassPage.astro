---
// CLASS PAGE TEMPLATE
//
// Header (rev 3, per Ben 2026-08-26): no photo, but not plain either. The
// page name is set as a two-line poster lockup: the first line in near
// black on the light ground, the second knocked out white on a red slab
// that bleeds the full width of the screen. The ambient red fluid runs
// behind it at higher intensity than the body sections, so the header
// moves without needing a picture. The structure repeats on every page
// (that consistency is the point) while the words inside it change, so
// the pages read as one system instead of one page copied.
//
// Body: photos sit beside the copy in the homepage's mat frames, sides
// alternating; the photo-less block becomes the centered closer.
//
// Pages supply data only: title, description, the two H1 lines, and the
// section list.
import Base from './Base.astro';
import ClassTicker from '../components/ClassTicker.astro';

export interface ClassSection {
  heading: string;
  /** paragraph HTML; <b> emphasis preserved from the client's copy */
  body: string;
  readMore?: { href: string; label: string };
  image?: { src: string; alt: string; width: number; height: number };
}

interface Props {
  pageTitle: string;
  description: string;
  /** the page name split for the poster lockup: [black line, red slab line] */
  h1Lines: [string, string];
  sections: ClassSection[];
  currentHref: string;
}

const { pageTitle, description, h1Lines, sections, currentHref } = Astro.props as Props;

const withPhoto = sections.filter((s) => s.image);
const closers = sections.filter((s) => !s.image);
---

<Base title={pageTitle} description={description}>
  <!-- ============ HEADER: two-line poster lockup, red slab ============ -->
  <section class="page-head grain fluid-host" data-fluid-opacity="0.7" data-fluid-pixel="12">
    <div class="wrap head-inner">
      <h1 class="page-title reveal">
        <span class="t-line">{h1Lines[0]}</span>
        <span class="t-line t-slab"><span class="t-slab-inner">{h1Lines[1]}</span></span>
      </h1>
    </div>
  </section>

  <!-- ============ SPLITS: photo beside copy, alternating ============ -->
  {
    withPhoto.map((s, i) => {
      const flip = i % 2 === 1;
      return (
        <section class={`split grain first-split${flip ? ' alt' : ''}${i > 0 ? ' subsequent' : ''} fluid-host`}>
          <div class={`wrap split-grid${flip ? ' flip' : ''}`}>
            {flip && (
              <figure class="split-media mat mat-white reveal">
                <img
                  src={s.image!.src}
                  alt={s.image!.alt}
                  loading="lazy"
                  width={s.image!.width}
                  height={s.image!.height}
                />
              </figure>
            )}
            <div class="split-copy">
              <h2 class="reveal">{s.heading}</h2>
              <div class="reveal" set:html={s.body} />
              {s.readMore && (
                <p class="read-more reveal">
                  <a href={s.readMore.href}>{s.readMore.label}</a>
                </p>
              )}
            </div>
            {!flip && (
              <figure class="split-media mat mat-warm reveal">
                <img
                  src={s.image!.src}
                  alt={s.image!.alt}
                  loading="lazy"
                  width={s.image!.width}
                  height={s.image!.height}
                />
              </figure>
            )}
          </div>
        </section>
      );
    })
  }

  <!-- ============ CLOSER: centered, carries the CTA ============ -->
  {
    closers.map((s) => (
      <section class="closer grain fluid-host">
        <div class="wrap closer-inner">
          <h2 class="reveal">{s.heading}</h2>
          <div class="reveal" set:html={s.body} />
          <span class="btn-ring reveal">
            <button class="btn js-open-lead" type="button">GET STARTED</button>
          </span>
        </div>
      </section>
    ))
  }

  <!-- ============ cross-nav to the other classes ============ -->
  <div class="ticker">
    <ClassTicker currentHref={currentHref} />
  </div>
</Base>

<style>
  /* ---------- header ---------- */
  .page-head {
    background: var(--ground);
    padding: clamp(34px, 5vw, 68px) 0 clamp(30px, 4vw, 54px);
  }
  .head-inner { position: relative; z-index: 1; }
  .page-title {
    font-weight: 900;
    font-size: clamp(40px, 8.4vw, 104px);
    line-height: 0.94;
    letter-spacing: -0.02em;
  }
  .t-line { display: block; }
  /* the red slab bleeds the full width of the screen; the section clips it */
  .t-slab {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    margin-top: clamp(6px, 0.8vw, 12px);
    padding-block: clamp(6px, 0.8vw, 14px);
    background: var(--accent);
    color: var(--on-dark);
  }
  .t-slab-inner {
    display: block;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  /* ---------- splits ---------- */
  /* the first split follows the header, so it gets less top padding than a
     standalone section would */
  .first-split { padding-top: clamp(38px, 4.4vw, 58px); }
  .split.subsequent { padding-top: var(--section-pad); }
  .read-more { margin-top: clamp(14px, 2vw, 22px); }
  .read-more a {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* ---------- closer ---------- */
  .closer {
    background: var(--ground);
    padding: clamp(20px, 3vw, 40px) 0 var(--section-pad);
  }
  .closer-inner {
    max-width: 720px;
    text-align: center;
  }
  .closer h2 {
    font-size: clamp(26px, 3.2vw, 40px);
    margin-bottom: clamp(16px, 2.2vw, 24px);
  }
  .closer p { margin-inline: auto; }
  .closer .btn-ring { margin-top: clamp(26px, 3.4vw, 40px); }

  /* ---------- cross-nav ticker ---------- */
  .ticker {
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
  }
</style>

<script>
  import { mountFluidBg } from '../scripts/fluid-bg.js';
  const reducedFluid = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedFluid) {
    const start = () => {
      document.querySelectorAll('.fluid-host').forEach((host) => {
        const opts = {};
        const o = Number(host.dataset.fluidOpacity);
        const p = Number(host.dataset.fluidPixel);
        if (o) opts.opacity = o;
        if (p) opts.pixelSize = p;
        mountFluidBg(host, opts);
      });
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 800);
  }
</script>
