---
// CLASS PAGE TEMPLATE
//
// Shape follows the client's own content, which is identical on all three
// class pages: a lead pitch (headline + paragraph + Read More), then two
// sub-blocks that sat side by side in the original WordPress build.
//
//   1. poster header  page name in two lines, the second knocked out white
//                     on a full-bleed red slab, ambient red fluid behind it
//                     at higher intensity so it moves without a photo
//   2. lead split     the page's photo beside the lead pitch
//   3. pair           the two sub-blocks side by side on the warm ground
//   4. class times    this class's sessions, read from src/data/schedule.js
//                     so the page can never disagree with /schedule/
//   5. close          centered call to action
//   6. ticker         cross-nav to the other classes
//
// Pages supply data only. One photo per page is deliberate: there are six
// photos total and three class pages, so each page opens with its own
// class-card photo (the card previews the page) and nothing repeats. Send
// more photography and the pair section can take a second split.
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ScheduleStrip from '../components/ScheduleStrip.astro';
import ClassTicker from '../components/ClassTicker.astro';

export interface LeadBlock {
  heading: string;
  /** paragraph HTML; <b> emphasis preserved from the client's copy */
  body: string;
  readMore?: { href: string; label: string };
  image: { src: string; alt: string; width: number; height: number };
}

export interface PairBlock {
  heading: string;
  body: string;
}

interface Props {
  pageTitle: string;
  description: string;
  /** the page name split for the poster lockup: [black line, red slab line] */
  h1Lines: [string, string];
  lead: LeadBlock;
  pair: PairBlock[];
  currentHref: string;
}

const { pageTitle, description, h1Lines, lead, pair, currentHref } = Astro.props as Props;
---

<Base title={pageTitle} description={description}>
  <!-- ============ HEADER: two-line poster lockup, red slab ============ -->
  <PageHeader lines={h1Lines} />

  <!-- ============ LEAD: photo beside the pitch ============ -->
  <section class="split grain lead-split fluid-host">
    <div class="wrap split-grid">
      <div class="split-copy">
        <h2 class="reveal">{lead.heading}</h2>
        <div class="reveal" set:html={lead.body} />
        {
          lead.readMore && (
            <p class="read-more reveal">
              <a href={lead.readMore.href}>{lead.readMore.label}</a>
            </p>
          )
        }
      </div>
      <figure class="split-media mat mat-warm reveal">
        <img
          src={lead.image.src}
          alt={lead.image.alt}
          loading="lazy"
          width={lead.image.width}
          height={lead.image.height}
        />
      </figure>
    </div>
  </section>

  <!-- ============ PAIR: the two sub-blocks, side by side ============ -->
  <section class="pair grain alt fluid-host">
    <div class="wrap pair-grid">
      {
        pair.map((p) => (
          <div class="pair-item reveal">
            <h3>{p.heading}</h3>
            <div set:html={p.body} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ====== CLASS TIMES: read straight from the shared schedule ====== -->
  <ScheduleStrip currentHref={currentHref} />

  <!-- ============ CLOSE: the call to action ============ -->
  <section class="close grain fluid-host">
    <div class="wrap close-inner">
      <span class="btn-ring reveal">
        <button class="btn js-open-lead" type="button">GET STARTED</button>
      </span>
    </div>
  </section>

  <!-- ============ cross-nav to the other classes ============ -->
  <div class="ticker">
    <ClassTicker currentHref={currentHref} />
  </div>
</Base>

<style>
  /* ---------- lead ---------- */
  /* follows the header, so less top padding than a standalone section */
  .lead-split { padding-top: clamp(38px, 4.4vw, 58px); }
  .read-more { margin-top: clamp(14px, 2vw, 22px); }
  .read-more a {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* ---------- pair ---------- */
  .pair {
    background: var(--ground-alt);
    padding: var(--section-pad) 0;
  }
  .pair-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .pair-item h3 {
    font-size: clamp(20px, 2.3vw, 27px);
    margin-bottom: clamp(12px, 1.6vw, 18px);
  }
  .pair-item :global(p) { max-width: 46ch; }

  /* ---------- close ---------- */
  .close {
    background: var(--ground);
    padding: clamp(40px, 5.5vw, 76px) 0;
  }
  .close-inner { text-align: center; }

  /* ---------- cross-nav ticker ---------- */
  .ticker {
    overflow: hidden;
    background: var(--accent);
    padding: clamp(14px, 1.8vw, 22px) 0;
  }

  @media (max-width: 800px) {
    .pair-grid { grid-template-columns: 1fr; gap: clamp(28px, 6vw, 40px); }
    .pair-item :global(p) { max-width: none; }
  }
</style>

<script>
  import { mountFluidBg } from '../scripts/fluid-bg.js';
  const reducedFluid = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedFluid) {
    const start = () => {
      document.querySelectorAll('.fluid-host').forEach((host) => {
        const opts = {};
        const o = Number(host.dataset.fluidOpacity);
        const p = Number(host.dataset.fluidPixel);
        if (o) opts.opacity = o;
        if (p) opts.pixelSize = p;
        mountFluidBg(host, opts);
      });
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 800);
  }
</script>
