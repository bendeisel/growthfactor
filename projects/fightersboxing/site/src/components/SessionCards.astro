---
// DAY CARDS
//
// One card per day that has a session, for a given program or audience.
// Shared by the class-page strips and the kids block on /schedule/, so a
// class's times look identical wherever they appear and come from one
// place: the schedule in Sanity, with the committed copy as the fallback.
//
// Rendered through the shared renderer, so the browser can re-render the
// same markup after checking Sanity for a change.
import { activeDays } from '../data/schedule.js';
import { getSessions } from '../lib/schedule-source.js';
import { renderCards } from '../lib/render-schedule.js';

interface Props {
  program?: string;
  audience?: string;
}
const { program, audience } = Astro.props as Props;

const sessions = await getSessions();
const board = activeDays(sessions, { program, audience });
const cardsHtml = renderCards(board);
---

<ul
  class="cards"
  data-live="cards"
  data-program={program}
  data-audience={audience}
  set:html={cardsHtml}
/>

<style is:global>
  /* Global rather than scoped because the cards are injected as HTML by the
     shared renderer, at build time and again after a live update, so they
     carry no scope hash. Every selector is nested under .cards. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* auto-fill, not auto-fit: a class with one session gets one column's
       width instead of stretching across the page */
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }
  .cards .card {
    background: var(--ground-alt);
    border-radius: calc(var(--radius-panel) + 6px);
    padding: clamp(16px, 1.8vw, 24px);
  }
  .cards .card-day {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 12px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--accent);
  }
  .cards .card-slots { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cards .card-slots li { display: grid; gap: 2px; }
  .cards .slot-time {
    font-family: var(--font-action);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cards .slot-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
  }
</style>
