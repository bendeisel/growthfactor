---
const mapsUrl =
  'https://www.google.com/maps/place/Fighters+Boxing+Gym/@36.152765,-86.837447,15z/data=!4m6!3m5!1s0x886461ed4d74f3c3:0xa3a537fa882902b1!8m2!3d36.1527649!4d-86.8374466!16s%2Fg%2F11j138pfhd?hl=en&entry=ttu';
const mapsEmbed =
  'https://maps.google.com/maps?q=405+42nd+Ave+N,+Nashville,+TN+37209&z=15&output=embed';
const facebookUrl = 'https://www.facebook.com/fightersboxinggym';
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="col brand-col">
      <a href="/">
        <img src="/img/logo-on-dark.png" alt="Fighters Nashville" width="220" height="78" loading="lazy" />
      </a>
      <address>
        <a href={mapsUrl} rel="noopener" target="_blank">405 42nd Ave N, Nashville, TN 37209</a>
        <a href="mailto:support@fightersnashville.com">support@fightersnashville.com</a>
        <a href="tel:6292892988">629-289-2988</a>
      </address>
    </div>

    <nav class="col" aria-label="Footer">
      <p class="col-label">Links</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/contact-us/">Contact Us</a></li>
        <!-- Blog is footer-only by design (Ben, this round): it earns its
             keep on search and internal links, not on the top nav. -->
        <li><a href="/boxing-blog/">Boxing Blog</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-conditions/">Terms &amp; Conditions</a></li>
      </ul>
    </nav>

    <div class="col">
      <p class="col-label">Get in touch</p>
      <div class="social">
        <a class="soc" href={facebookUrl} rel="noopener" target="_blank">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8.5V6.8c0-.8.5-1.3 1.4-1.3H17V2.4h-2.4C11.9 2.4 10.4 4 10.4 6.5V8.5H8v3.2h2.4v9.9H14v-9.9h2.6l.4-3.2H14Z" fill="currentColor" />
          </svg>
          <span class="sr-only">Facebook</span>
        </a>
        <a class="soc" href="https://www.instagram.com/fightersnashville/" rel="noopener" target="_blank">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
          </svg>
          <span class="sr-only">Instagram</span>
        </a>
      </div>
    </div>

    <div class="col map-col">
      <p class="col-label">Find us</p>
      <div class="map-frame">
        <iframe
          src={mapsEmbed}
          title="Map to Fighters Boxing Gym, 405 42nd Ave N, Nashville"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>

  <div class="wrap legal">
    <p>© 2026. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ground-footer);
    color: var(--on-dark);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.5fr 0.9fr 0.8fr 1.4fr;
    gap: clamp(28px, 4vw, 56px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .brand-col img { width: min(220px, 60vw); height: auto; }
  address {
    font-style: normal;
    margin-top: 22px;
    display: grid;
    gap: 8px;
  }
  .site-footer a { color: var(--on-dark); }
  .site-footer a:hover, .site-footer a:focus-visible { color: var(--accent); }
  .col-label {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-light);
    margin-bottom: 14px;
    font-weight: 700;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .social { display: flex; gap: 14px; }
  .soc { display: inline-flex; padding: 4px; }
  .map-frame {
    border-radius: var(--radius-panel);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .map-frame iframe {
    display: block;
    width: 100%;
    height: 220px;
    border: 0;
  }
  .legal {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 18px;
    padding-bottom: 22px;
  }
  .legal p { color: var(--text-light); font-size: 14px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .map-col { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
