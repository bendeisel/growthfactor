---
const mapsUrl =
  'https://www.google.com/maps/place/Fighters+Boxing+Gym/@36.152765,-86.837447,15z/data=!4m6!3m5!1s0x886461ed4d74f3c3:0xa3a537fa882902b1!8m2!3d36.1527649!4d-86.8374466!16s%2Fg%2F11j138pfhd?hl=en&entry=ttu';
---

<section class="contact-band" id="contact">
  <div class="wrap">
    <h2 class="reveal">
      <a href="mailto:support@fightersnashville.com">support@fightersnashville.com</a>
    </h2>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap cols">
    <div class="col brand-col">
      <a href="/">
        <img src="/img/logo-on-dark.png" alt="Fighters Nashville" width="220" height="78" loading="lazy" />
      </a>
      <address>
        <a href={mapsUrl} rel="noopener" target="_blank">405 42nd Ave N, Nashville, TN 37209</a>
        <a href="mailto:support@fightersnashville.com">support@fightersnashville.com</a>
        <a href="tel:6292892988">629-289-2988</a>
      </address>
    </div>

    <nav class="col" aria-label="Footer">
      <h6>Links</h6>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/contact-us/">Contact Us</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-conditions/">Terms &amp; Conditions</a></li>
      </ul>
    </nav>

    <div class="col">
      <h6>Get in touch</h6>
      <a class="ig" href="https://www.instagram.com/fightersnashville/" rel="noopener" target="_blank">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="1.8" />
          <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
          <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
        </svg>
        <span class="sr-only">Instagram</span>
      </a>
    </div>
  </div>

  <div class="wrap legal">
    <p>© 2026. All rights reserved.</p>
  </div>
</footer>

<style>
  /* Pre-footer contact band — the site's dark punctuation strip. The live
     lime #B6D40E heading is a theme default, not brand: shipped as white
     with the red on hover (flagged in source/copy.md). */
  .contact-band {
    background: var(--ground-band);
    padding: clamp(36px, 6vw, 64px) 0;
    text-align: center;
  }
  .contact-band h2 {
    font-size: clamp(22px, 5vw, 62px);
    font-weight: 500;
    line-height: 0.8;
    overflow-wrap: anywhere;
  }
  .contact-band a { color: var(--on-dark); }
  .contact-band a:hover, .contact-band a:focus-visible { color: var(--accent); }

  .site-footer {
    background: var(--ground-footer);
    color: var(--on-dark);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .brand-col img { width: min(220px, 60vw); height: auto; }
  address {
    font-style: normal;
    margin-top: 22px;
    display: grid;
    gap: 8px;
  }
  .site-footer a { color: var(--on-dark); }
  .site-footer a:hover, .site-footer a:focus-visible { color: var(--accent); }
  h6 {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-light);
    margin-bottom: 14px;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ig { display: inline-flex; padding: 4px; }
  .legal {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 18px;
    padding-bottom: 22px;
  }
  .legal p { color: var(--text-light); font-size: 14px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
