---
// THE ADULT WEEK, AS ONE GRID
//
// A time rail down the left and the seven days across the top, so 6 PM on
// Monday sits beside 6 PM on Tuesday, the way Ben wanted it. Rows exist
// only for times that actually have a class, which keeps the whole week to
// one compact piece instead of a page of empty boxes.
//
// The classes come from Sanity at build time and get re-checked in the
// browser, so the gym changes a class time once and this grid follows.
//
// Kids classes are not here: they get their own block further down
// /schedule/ and their own page.
import { matrix, programs } from '../data/schedule.js';
import { getSessions } from '../lib/schedule-source.js';
import { renderMatrix } from '../lib/render-schedule.js';

const sessions = await getSessions();
const rows = matrix(sessions, { audience: 'adult' });
const chips = programs.filter((p) => p.audience === 'adult');
// Rendered through the shared renderer so the browser can re-render the
// same markup after checking Sanity for a change.
const matrixHtml = renderMatrix(rows);
---

<div class="cal">
  <div class="filters" role="group" aria-label="Filter the schedule by class">
    <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">All classes</button>
    {
      chips.map((p) => (
        <button class="chip" type="button" data-filter={p.slug} aria-pressed="false">
          {p.label}
        </button>
      ))
    }
  </div>

  <div class="matrix-scroll">
    <div class="matrix" data-live="matrix" data-audience="adult" set:html={matrixHtml} />
  </div>
  <p class="matrix-note">Adult classes and open gym. Kids classes are below.</p>
</div>

<style is:global>
  /* Global rather than scoped because the grid is injected as HTML by the
     shared renderer, at build time and again after a live update, so it
     carries no scope hash. Every selector is nested under .cal to keep
     that out of the rest of the site. */
  .cal { position: relative; z-index: 1; }
  /* the grid sets display on its parts, so hidden needs to win */
  .cal [hidden] { display: none !important; }

  /* ---------- filter chips ---------- */
  .cal .filters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 1vw, 12px);
    margin-bottom: clamp(20px, 2.6vw, 32px);
  }
  .cal .chip {
    font-family: var(--font-action);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-dark);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 12px 22px;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .cal .chip:hover, .cal .chip:focus-visible { border-color: var(--accent); color: var(--accent); }
  .cal .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-dark);
  }

  /* ---------- the grid ----------
     One CSS grid holds the whole week, which is what keeps a time row
     aligned across all seven days. On a narrow screen it scrolls sideways
     inside its own frame, with the time rail pinned, rather than breaking
     into seven stacked blocks. */
  .cal .matrix-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-panel) + 6px);
    background: var(--ground);
  }
  .cal .matrix {
    display: grid;
    grid-template-columns: 76px repeat(7, minmax(104px, 1fr));
    min-width: 720px;
  }
  .cal .m-corner, .cal .m-head {
    background: var(--accent);
    color: var(--on-dark);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    padding: 11px 6px;
  }
  .cal .m-corner { position: sticky; left: 0; z-index: 2; }
  .cal .m-head-short { display: none; }
  .cal .m-time {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--ground);
    border-top: 1px solid var(--border);
    padding: 12px 12px 12px 10px;
    text-align: right;
    font-family: var(--font-action);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .cal .m-cell {
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    padding: 7px;
    display: grid;
    gap: 5px;
    align-content: start;
  }
  .cal .class-chip {
    display: block;
    background: var(--ground-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 9px 9px 0;
    padding: 7px 9px;
  }
  .cal .chip-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.2;
  }
  .cal .chip-until {
    display: block;
    margin-top: 2px;
    font-family: var(--font-action);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cal .matrix-note {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--text-light);
  }

  @media (max-width: 760px) {
    .cal .m-head-long { display: none; }
    .cal .m-head-short { display: inline; }
    .cal .matrix { min-width: 620px; grid-template-columns: 64px repeat(7, minmax(78px, 1fr)); }
  }
</style>

<script>
  // Filtering is progressive: without JavaScript every class is already on
  // the page and the chips simply do nothing.
  const cal = document.querySelector('.cal');
  if (cal) {
    const chips = cal.querySelectorAll('.chip');

    const apply = (filter) => {
      chips.forEach((c) => {
        const on = c.dataset.filter === filter;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });

      // Queried at apply time, not cached: the browser may have re-rendered
      // the grid from Sanity since the page loaded.
      const shownPerRow = new Map();
      cal.querySelectorAll('.class-chip').forEach((chip) => {
        const row = chip.closest('.m-cell')?.dataset.row;
        const match =
          filter === 'all' || (chip.dataset.programs || '').split(' ').includes(filter);
        chip.hidden = !match;
        if (match && row) shownPerRow.set(row, (shownPerRow.get(row) || 0) + 1);
      });

      // A time with nothing left in it drops out, so filtering keeps the
      // grid as tight as it is unfiltered.
      cal.querySelectorAll('[data-row]').forEach((el) => {
        el.hidden = !shownPerRow.get(el.dataset.row);
      });
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter)));

    // A live update replaces the grid, so re-apply the active filter.
    document.addEventListener('schedule:updated', () => {
      const active = cal.querySelector('.chip.is-on');
      apply(active ? active.dataset.filter : 'all');
    });
  }
</script>
