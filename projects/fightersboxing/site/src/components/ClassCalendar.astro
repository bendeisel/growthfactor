---
// THE ADULT WEEK BOARD
//
// Every adult session in the schedule, laid out as one card per day with a
// filter row above it. The sessions come from Sanity at build time and get
// re-checked in the browser, so the gym changes a class time once and this
// board follows. Kids classes are not on this board: they get
// their own block further down /schedule/ and their own page, per Ben.
//
// Deliberately not Nashville MMA's time-rail matrix: Fighters runs two to
// five sessions a day, so a shared 7-column time grid would be mostly
// empty. Day cards read at a glance, stack cleanly on a phone, and the
// light ground plus deep rounding keeps the two gyms apart.
//
// The eighth cell is a call to action, so the grid closes at 4x2 and the ask
// sits where someone has just finished reading the times.
import { week, programs } from '../data/schedule.js';
import { getSessions } from '../lib/schedule-source.js';
import { renderBoard } from '../lib/render-schedule.js';

const sessions = await getSessions();
const board = week(sessions, { audience: 'adult' });
const chips = programs.filter((p) => p.audience === 'adult');
// Rendered through the shared renderer so the browser can re-render the
// same markup after checking Sanity for a change.
const boardHtml = renderBoard(board);
---

<div class="cal">
  <div class="filters" role="group" aria-label="Filter the schedule by class">
    <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">All classes</button>
    {
      chips.map((p) => (
        <button class="chip" type="button" data-filter={p.slug} aria-pressed="false">
          {p.label}
        </button>
      ))
    }
  </div>

  <div class="board" data-live="board" data-audience="adult">
    <Fragment set:html={boardHtml} />

    <div class="day ask">
      <p class="day-name">New here?</p>
      <p class="ask-copy">
        Stop in for a tour, meet the coaches, and we will point you at the class that
        fits where you are now.
      </p>
      <button class="ask-btn js-open-lead" type="button">Get more info</button>
    </div>
  </div>
</div>

<style is:global>
  /* Global rather than scoped because the day cells are injected as HTML by
     the shared renderer, at build time and again after a live update, so
     they carry no scope hash. Every selector is nested under .cal to keep
     that out of the rest of the site. */
  .cal { position: relative; z-index: 1; }

  /* ---------- filter chips ---------- */
  .cal .filters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 1vw, 12px);
    margin-bottom: clamp(24px, 3.4vw, 40px);
  }
  .cal .chip {
    font-family: var(--font-action);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-dark);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 12px 22px;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .cal .chip:hover, .cal .chip:focus-visible { border-color: var(--accent); color: var(--accent); }
  .cal .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-dark);
  }

  /* ---------- the board ---------- */
  .cal .board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }
  .cal .day {
    background: var(--ground);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-panel) + 6px);
    padding: clamp(18px, 1.9vw, 26px);
    display: flex;
    flex-direction: column;
  }
  .cal .day-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 14px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--accent);
  }
  .cal .slots { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .cal .slot {
    display: grid;
    gap: 2px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
  }
  .cal .slot-time {
    font-family: var(--font-action);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cal .slot-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
  }
  .cal .day-empty {
    font-size: 14px;
    color: var(--text-light);
    margin: 0;
  }

  /* ---------- the call to action cell ---------- */
  .cal .ask {
    background: var(--ground-band);
    border-color: var(--ground-band);
    color: var(--on-dark);
  }
  .cal .ask .day-name { color: var(--on-dark); }
  .cal .ask-copy { font-size: 14px; line-height: 1.6; margin: 0 0 auto; }
  .cal .ask-btn {
    font-family: var(--font-action);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--on-dark);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-pill);
    padding: 15px 24px;
    margin-top: 18px;
    cursor: pointer;
    transition: background 0.3s;
  }
  .cal .ask-btn:hover, .cal .ask-btn:focus-visible { background: var(--accent-hover); }

  @media (max-width: 1080px) {
    .cal .board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .cal .board { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Filtering is progressive: without JavaScript every session is already
  // on the page and the chips simply do nothing.
  const cal = document.querySelector('.cal');
  if (cal) {
    const chips = cal.querySelectorAll('.chip');

    const apply = (filter) => {
      chips.forEach((c) => {
        const on = c.dataset.filter === filter;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      // Queried at apply time, not cached: the browser may have re-rendered
      // these cells from Sanity since the page loaded.
      cal.querySelectorAll('.day[data-day]').forEach((day) => {
        let shown = 0;
        day.querySelectorAll('.slot').forEach((slot) => {
          const match =
            filter === 'all' || (slot.dataset.programs || '').split(' ').includes(filter);
          slot.hidden = !match;
          if (match) shown += 1;
        });
        const empty = day.querySelector('.day-empty');
        if (empty) empty.hidden = shown > 0;
      });
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter)));

    // A live update wipes the hidden flags, so re-apply the active filter.
    document.addEventListener('schedule:updated', () => {
      const active = cal.querySelector('.chip.is-on');
      apply(active ? active.dataset.filter : 'all');
    });
  }
</script>
