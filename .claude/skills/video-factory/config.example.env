# Growth Factor video factory. Copy to config.env and fill in.
# config.env is git-ignored: it holds keys that cost money when used.
#
# Anything here can be overridden per run by exporting the same name in the
# shell. Values are single line only, no quotes needed.

# ---------------------------------------------------------------- credentials
# Rewrites. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Renders. HeyGen -> Settings -> API. Treat it like a credit card.
HEYGEN_API_KEY=
# Only needed if GF_WHISPER_BACKEND=openai below.
OPENAI_API_KEY=

# ------------------------------------------------------------------- identity
# Who the narration is written for, and what the product is called on screen.
GF_PRESENTER=Ben
GF_COMPANY=Growth Factor
# The white-label product name. This is the name the narration uses. The
# rewrite is told never to name the platform underneath it, so get this right.
GF_PRODUCT_NAME=
# Optional extra voice notes appended to the rewrite prompt. One line.
GF_EXTRA_VOICE=

# --------------------------------------------------------------- transcription
# local  = faster-whisper on this machine. Free, private, needs a model
#          download the first time.
# openai = the hosted endpoint. No download, costs per minute, uploads the
#          audio. Capped at 25 MB, which is about 90 minutes as mono mp3.
GF_WHISPER_BACKEND=local
GF_WHISPER_MODEL=small.en
GF_WHISPER_DEVICE=cpu
GF_WHISPER_COMPUTE=int8
GF_OPENAI_STT_MODEL=whisper-1

# ------------------------------------------------------------------ segmenting
# Shortest and longest beat, in seconds. Below the minimum a beat gets merged
# into its neighbour, above the maximum it gets split at the widest pause.
GF_BEAT_MIN=6
GF_BEAT_MAX=20
# How fast the avatar speaks. 2.5 words per second is about 150 wpm, which is
# a normal instructional pace. MEASURE THIS once against a real render and put
# the real number here: every word budget in the pipeline is derived from it,
# so being wrong here shows up as drift on every single beat.
GF_WORDS_PER_SEC=2.5

# -------------------------------------------------------------------- rewrite
GF_REWRITE_MODEL=claude-opus-5
GF_REWRITE_EFFORT=high
# Beats sent up per request. Lower it if a response ever hits max_tokens.
GF_REWRITE_BATCH=25
GF_REWRITE_MAX_TOKENS=32000
# How far a rewritten line may drift from its word budget before it is sent
# back. 0.15 is 15 percent either way.
GF_BUDGET_TOLERANCE=0.15

# --------------------------------------------------------------------- heygen
# Get these from: ./vf.sh doctor, then heygen.py avatars / heygen.py voices
GF_HEYGEN_AVATAR_ID=
GF_HEYGEN_VOICE_ID=
GF_HEYGEN_AVATAR_STYLE=normal
GF_HEYGEN_VOICE_SPEED=1.0
# Square output, because the avatar is cropped to a circle for the corner.
GF_AVATAR_W=720
GF_AVATAR_H=720
# Flat background behind the avatar. In disc mode this is the colour inside
# the circle, so make it a brand colour. In cutout mode it is what gets keyed
# out, so make it a colour that appears nowhere on the presenter.
GF_AVATAR_BG=#101114
# Renders running at once. Plan dependent. Too high and HeyGen queues them
# anyway, or rejects them.
GF_HEYGEN_CONCURRENCY=2
GF_HEYGEN_POLL_SECONDS=20
GF_HEYGEN_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------ composite
GF_OUT_W=1920
GF_OUT_H=1080
GF_OUT_FPS=30
GF_OUT_CRF=20
GF_OUT_PRESET=medium
# disc   = circular corner overlay on a flat background. Works on any plan.
# cutout = the flat background keyed out so the presenter floats on the screen
#          recording. Looks better, needs an even background and a presenter
#          who is not wearing anything near GF_AVATAR_BG.
GF_PIP_STYLE=disc
GF_PIP_SIZE=320
GF_PIP_MARGIN=48
GF_PIP_POSITION=bottom-right
GF_KEY_SIMILARITY=0.18
GF_KEY_BLEND=0.05

# How far the footage may be stretched or compressed to meet the narration
# before the remainder is taken as a freeze on the last frame instead. 1.25 is
# invisible on a screen recording. Past about 1.4 it reads as a fast-forward.
GF_MAX_SPEEDUP=1.25
GF_MAX_SLOWDOWN=1.25

# ------------------------------------------------------------------- captions
# Two lines at 38 characters is the broadcast convention and what course
# players are laid out for. 74 is the per-cue budget across both lines.
GF_CAPTION_CHARS=74
GF_CAPTION_LINE_CHARS=38
GF_CAPTION_MIN_SECONDS=1.0
GF_CAPTION_MAX_SECONDS=6.0
# Only used by `captions.py --burn`. Sidecar .vtt is better wherever the
# player supports it, since burning in costs a second h264 generation.
GF_CAPTION_STYLE=FontName=Arial,FontSize=22,PrimaryColour=&H00FFFFFF,BackColour=&H90000000,BorderStyle=3,Outline=0,Shadow=0,MarginV=48

# ----------------------------------------------------------------- thumbnails
# A frame from the finished video, darkened, with the module label and title
# set over it. Same treatment on every video, which is the whole point.
GF_THUMB_W=1280
GF_THUMB_H=720
GF_THUMB_QUALITY=88
# Where to grab the frame, 0 to 1 through the video. The opening seconds are
# usually an intro or a fade and make a poor tile.
GF_THUMB_AT=0.35
# The accent is the rule above the label and the label itself. Usually the
# only one of these worth changing.
GF_THUMB_ACCENT=#F5A524
GF_THUMB_TEXT=#FFFFFF
GF_THUMB_SCRIM=#0A0B0D
GF_THUMB_SCRIM_STRENGTH=0.92
GF_THUMB_BLUR=0
GF_THUMB_MARGIN=64
GF_THUMB_TITLE_SIZE=76
GF_THUMB_TITLE_MIN_SIZE=40
GF_THUMB_TITLE_LINES=3
GF_THUMB_LABEL_SIZE=24
GF_THUMB_LABEL_TRACKING=2.4
GF_THUMB_LABEL_GAP=26
GF_THUMB_RULE_W=56
GF_THUMB_RULE_H=4
GF_THUMB_RULE_GAP=22
# Drop a logo.png in a job's assets/ folder and it lands top right at this
# height. Left out entirely if the file is not there.
GF_THUMB_LOGO_H=44
# Leave blank to auto-detect. Set these to brand fonts once they are installed.
GF_THUMB_FONT_BOLD=
GF_THUMB_FONT_REGULAR=

# --------------------------------------------------------------- gohighlevel
# Only needed for publish.py. Everything up to and including verify works
# without any of it.
#
# A Private Integration token from the SUB-ACCOUNT, with the medias.write and
# courses.write scopes. Sub-account, not agency: the course lands in a
# location.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Optional. Attributes the import to a user.
GHL_USER_ID=
# Optional. Uploads land in this media library folder instead of the root.
GHL_MEDIA_FOLDER_ID=
# The course the videos are imported into.
GHL_COURSE_TITLE=
GHL_COURSE_DESCRIPTION=
GHL_COURSE_IMAGE_URL=
# Set this and the import carries an instructor block naming GF_PRESENTER.
GHL_INSTRUCTOR_BIO=
# Override only for testing against a stand-in server.
GHL_API_BASE=https://services.leadconnectorhq.com
