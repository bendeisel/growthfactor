# Growth Factor site factory — copy to config.env and fill in.
# config.env is git-ignored: it holds a token that can delete websites.

# hPanel -> API -> generate. Sent as `Authorization: Bearer ...`.
HOSTINGER_API_TOKEN=

# The Hostinger website that hosts previews. This MUST be a website that
# hosts nothing else: the static-deploy endpoint replaces a whole website's
# contents, so a preview sharing a website with a real site dies the first
# time that site ships. See references/preview-hosting.md.
GF_PREVIEW_DOMAIN=growth-factor.ai

# The hostname clients are actually sent. Created once as a subdomain of
# GF_PREVIEW_DOMAIN pointing at GF_PREVIEW_DIR:
#   ./hostinger.sh subdomain-add
GF_PREVIEW_HOST=preview.growth-factor.ai
GF_PREVIEW_SUBDOMAIN=preview

# Directory under the preview website's public_html holding all previews.
# Each build lands in <GF_PREVIEW_DIR>/<slug>/.
GF_PREVIEW_DIR=previews

# Optional. Read from the API when blank, which is the safer default.
GF_PREVIEW_USERNAME=
