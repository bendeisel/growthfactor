# Growth Factor ads factory. Copy to config.env and fill in.
# config.env is git-ignored: these credentials can spend a client's money.
#
# Setup walkthrough: references/auth-setup.md
# Check what works after filling this in:  python3 scripts/ads.py doctor

# ---------------------------------------------------------------------------
# Google: one Cloud project, one OAuth client, one refresh token.
# The refresh token belongs to ben@growth-factor.ai and carries every scope
# for Ads, Tag Manager, Search Console and Analytics at once. Mint it with:
#   python3 scripts/google_oauth_setup.py
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Ads only. Applied for once in the API Center of the MCC, then reused
# for every client account the MCC manages.
GOOGLE_ADS_DEVELOPER_TOKEN=

# The manager account (MCC) the clients are linked under. Digits only, no
# dashes. Sent as the login-customer-id header on every Google Ads call; a
# call through a manager account without it fails USER_PERMISSION_DENIED.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Pinned deliberately. Google sunsets a version about a year after release,
# and each version is a separate endpoint, so a silent bump is a silent
# breakage. v25 released 2026-07-22, sunsets around August 2027.
GOOGLE_ADS_API_VERSION=v25

# ---------------------------------------------------------------------------
# Meta: one app, one system user, one long-lived token.
# The system user lives in Growth Factor's Business Manager and gets assigned
# to each client's ad account as they come aboard, so the token never changes
# when a client is added.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=

# Growth Factor's Business Manager ID. Used to list owned and client ad
# accounts so a new client's account ID never has to be typed by hand.
META_BUSINESS_ID=

# Pinned for the same reason as Google Ads. Meta keeps a version alive about
# two years. Confirm the current one in the app dashboard, then bump here:
#   python3 scripts/meta.py versions
META_API_VERSION=v26.0
