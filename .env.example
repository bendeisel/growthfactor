# Command Center — environment
# Copy to .env.local. Every value is optional in Phase 1: unset sources fall
# back to mock data and unset providers report themselves as unconfigured.

# --- Metrics (Phase 2) -------------------------------------------------------
# Both endpoints return the normalized payload documented in
# lib/metrics/adapters/normalized.ts. Money in dollars.

# n8n webhook that pulls Glow Fox (locked decision, spec §7).
GLOWFOX_N8N_URL=
GLOWFOX_N8N_TOKEN=

# GHL subaccount rollup — n8n workflow or a serverless function using the
# existing PIT tokens.
GHL_METRICS_URL=
GHL_METRICS_TOKEN=

# --- Model switch (Phase 3) --------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCLAW_API_KEY=

# Megatron's web transport — same brain as Telegram.
MEGATRON_WEBHOOK_URL=

# --- Workspace panels (Phase 3 / 4) ------------------------------------------
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# One OAuth client covers Drive, Gmail and Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
