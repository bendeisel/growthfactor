# Copy to .env and fill in only what you actually use. Nothing here is required
# for the free local pipeline: SQLite plus public data needs no keys at all.

# ---- Storage (optional, only for the Supabase path) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- GHL push (optional, only for `gf push`) ----
# Sub-account Private Integration Token, created in GHL under
# Settings > Private Integrations. Needs contacts and opportunities scopes.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# ---- Optional paid data. Leave blank to stay at zero cost. ----
REAPI_API_KEY=

# ---- Optional, raises Socrata rate limits. Free to obtain. ----
SOCRATA_APP_TOKEN=
