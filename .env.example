# Command Center — environment
# Copy to .env.local. Nothing here is required to run locally: unset sources fall
# back to badged mock data, and unset providers say which key they need.

# --- Access ------------------------------------------------------------------
# Required in production. Without it the app refuses to serve rather than
# exposing revenue data; locally it runs open and shows an "unprotected" badge.
COMMAND_CENTER_PASSWORD=

# Optional. Sessions are signed with a key derived from the password, so
# changing the password signs everyone out. Set this to sign with a dedicated
# secret and survive a password change instead.
AUTH_SECRET=

# --- Metrics ingestion (Phase 2) ---------------------------------------------
# Preferred path: n8n POSTs to /api/ingest on a schedule with this bearer token.
# Payload shape: lib/metrics/adapters/normalized.ts (money in dollars).
INGEST_TOKEN=

# Minutes before a stored reading is shown as stale. Set a little above the n8n
# schedule interval.
METRICS_FRESH_MINUTES=90

# Where the snapshot log lives. Point at a persistent volume in production.
DATA_DIR=

# Fallback pull path, used only for businesses with no stored reading. Same
# payload as ingestion.
GLOWFOX_N8N_URL=
GLOWFOX_N8N_TOKEN=
GHL_METRICS_URL=
GHL_METRICS_TOKEN=

# --- Model switch ------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCLAW_API_KEY=

# Optional endpoint overrides (any OpenAI-compatible API).
OPENAI_BASE_URL=
OPENCLAW_BASE_URL=

# Reasoning depth for Anthropic models: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=xhigh

# Megatron's web transport — same brain as Telegram (Phase 3).
MEGATRON_WEBHOOK_URL=

# --- Budget ------------------------------------------------------------------
# Defaults are the spec's $5/day soft cap and $100/month hard cap. The daily cap
# warns; the monthly cap refuses the call.
BUDGET_DAILY_SOFT_CAP_USD=5
BUDGET_MONTHLY_HARD_CAP_USD=100

# Where the daily spend log lives (memory/budget-YYYY-MM-DD.json).
MEMORY_DIR=

# Token rates in cents per million, for providers whose prices we don't hard-code.
# Without these, turns on that provider log tokens and report cost as unpriced
# rather than guessing. Anthropic list prices are built in; set these to override.
OPENAI_INPUT_CENTS_PER_MTOK=
OPENAI_OUTPUT_CENTS_PER_MTOK=
OPENCLAW_INPUT_CENTS_PER_MTOK=
OPENCLAW_OUTPUT_CENTS_PER_MTOK=

# --- Workspace panels (Phase 3 / 4) ------------------------------------------
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# One OAuth client covers Drive, Gmail and Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
